// Định nghĩa datasource và generator cho PostgreSQL
// Chỉnh sửa lại DATABASE_URL trong .env cho đúng thông tin kết nối

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum trạng thái apply job
/// Trạng thái ứng tuyển
enum ApplyStatus {
  Applied
  Screening
  Interview
  Offer
  Hired
  Rejected
  Withdrawn
}

enum InterviewType {
  Online
  Onsite
  Phone
}

enum InterviewStatus {
  Scheduled
  Completed
  Cancelled
}

enum InterviewResult {
  Pending
  Passed
  Failed
}

enum JobReportStatus {
  Pending
  Resolved
  Dismissed
}

// Enum vai trò người dùng
/// Vai trò người dùng
enum UserRole {
  Admin
  Recruiter
  Candidate
}

/// Bảng người dùng hệ thống
model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  createdAt               DateTime                 @default(now())
  deletedAt               DateTime?
  role                    UserRole                 @default(Candidate)
  passwordVersion         Int                      @default(0)
  // Quan hệ
  candidateProfile        CandidateProfile?
  jobPosts                JobPost[]                @relation("EmployerJobs")
  jobs                    Job[]                    @relation("CandidateJobs")
  notifications           Notification[]
  reviews                 Review[]
  savedJobs               SavedJob[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  matchResults            MatchResult[]
  paymentOrders           PaymentOrder[]
  creditLedger            CreditLedger[]
  interviews              Interview[]              @relation("InterviewerInterviews")
  reportedJobs            JobReport[]              @relation("ReporterReports")
  newsletterSubscriptions NewsletterSubscription[]
  auditLogs               AuditLog[]

  @@index([deletedAt])
}

enum JobPostStatus {
  Draft
  PendingApproval
  Active
  Closed
  Expired
  Rejected
}

enum CompanyVerificationStatus {
  Pending
  Verified
  Rejected
}

enum PaymentOrderStatus {
  Pending
  Paid
  Failed
  Expired
  Refunded
}

enum CreditType {
  JobPost
  FeaturedJob
  MatchUnlock
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   @db.VarChar(40)
  providerAccountId String   @db.VarChar(255)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Bảng blog
model Blog {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(200)
  excerpt     String     @db.VarChar(500)
  content     String
  slug        String?    @db.VarChar(100)
  category    String     @db.VarChar(50)
  tags        String // JSON string hoặc chuỗi phân cách
  publishedAt DateTime
  readTime    String?    @db.VarChar(20)
  views       Int        @default(0)
  likes       Int        @default(0)
  featured    Boolean    @default(false)
  image       String?    @db.VarChar(500)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime?
  authorId    Int
  author      BlogAuthor @relation(fields: [authorId], references: [id])
  blogViews   BlogView[]
  blogLikes   BlogLike[]
}

/// Tác giả blog
model BlogAuthor {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  avatar    String?  @db.VarChar(500)
  role      String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  blogs     Blog[]
}

/// Danh mục blog
model BlogCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
}

/// Lượt xem blog
model BlogView {
  id        Int      @id @default(autoincrement())
  blogId    Int
  userId    String?
  ipAddress String?
  viewedAt  DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
}

/// Lượt thích blog
model BlogLike {
  id      Int      @id @default(autoincrement())
  blogId  Int
  userId  String
  likedAt DateTime @default(now())
  blog    Blog     @relation(fields: [blogId], references: [id])
}

/// Hồ sơ ứng viên
model CandidateProfile {
  id                String           @id @default(uuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id])
  resumeUrl         String?          @db.VarChar(300)
  experience        String?          @db.VarChar(1000)
  experienceYears   Int?
  skills            String?          @db.VarChar(500)
  education         String?          @db.VarChar(200)
  preferredLocation String?          @db.VarChar(200)
  preferredJobType  String?          @db.VarChar(100)
  expectedSalary    Decimal?         @db.Decimal(18, 2)
  dob               DateTime?
  gender            String?          @db.VarChar(10)
  portfolioUrl      String?          @db.VarChar(300)
  linkedinUrl       String?          @db.VarChar(300)
  githubUrl         String?          @db.VarChar(300)
  certificates      String?          @db.VarChar(1000)
  summary           String?          @db.VarChar(1000)
  candidateSkills   CandidateSkill[]
}

model CandidateSkill {
  id                 String           @id @default(uuid())
  candidateProfileId String
  normalizedName     String           @db.VarChar(100)
  displayName        String           @db.VarChar(100)
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, normalizedName])
  @@index([normalizedName, candidateProfileId])
}

/// Danh mục ngành nghề
model Category {
  id       String    @id @default(uuid())
  name     String    @db.VarChar(100)
  icon     String?   @db.VarChar(200)
  color    String?   @db.VarChar(50)
  jobPosts JobPost[]
}

/// Công ty
model Company {
  id                 String                    @id @default(uuid())
  name               String                    @db.VarChar(200)
  logo               String?                   @db.VarChar(300)
  description        String?                   @db.VarChar(1000)
  location           String?                   @db.VarChar(100)
  employees          String?                   @db.VarChar(50)
  industry           String?                   @db.VarChar(100)
  openJobs           Int
  rating             Float
  website            String?                   @db.VarChar(200)
  founded            String?                   @db.VarChar(10)
  tags               String?                   @db.VarChar(500)
  userId             String?
  deletedAt          DateTime?
  verificationStatus CompanyVerificationStatus @default(Pending)
  verifiedAt         DateTime?
  version            Int                       @default(0)
  jobPosts           JobPost[]
  reviews            Review[]

  @@index([deletedAt])
  @@index([verificationStatus, name])
}

/// Bảng ứng tuyển job
model Job {
  id            String                     @id @default(uuid())
  jobPostId     String
  candidateId   String
  appliedAt     DateTime
  cvUrl         String?                    @db.VarChar(300)
  status        ApplyStatus                @default(Applied)
  version       Int                        @default(0)
  jobPost       JobPost                    @relation(fields: [jobPostId], references: [id])
  candidate     User                       @relation("CandidateJobs", fields: [candidateId], references: [id])
  statusHistory ApplicationStatusHistory[]
  interviews    Interview[]

  @@unique([candidateId, jobPostId])
  @@index([jobPostId, status])
  @@index([jobPostId, status, appliedAt])
  @@index([candidateId, appliedAt])
}

model ApplicationStatusHistory {
  id            String       @id @default(uuid())
  applicationId String
  fromStatus    ApplyStatus?
  toStatus      ApplyStatus
  changedBy     String?
  changedAt     DateTime     @default(now())
  reason        String?      @db.VarChar(1000)
  application   Job          @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, changedAt])
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String
  type          InterviewType
  startAt       DateTime
  endAt         DateTime
  location      String?         @db.VarChar(500)
  meetingUrl    String?         @db.VarChar(500)
  interviewerId String
  status        InterviewStatus @default(Scheduled)
  result        InterviewResult @default(Pending)
  notes         String?         @db.VarChar(4000)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime?
  version       Int             @default(0)
  application   Job             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer   User            @relation("InterviewerInterviews", fields: [interviewerId], references: [id], onDelete: Restrict)

  @@index([interviewerId, startAt, status])
  @@index([applicationId, startAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String   @db.VarChar(100)
  entityType    String   @db.VarChar(100)
  entityId      String   @db.VarChar(100)
  before        Json?
  after         Json?
  ipAddress     String?  @db.VarChar(64)
  correlationId String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxMessage {
  id               String    @id @default(uuid())
  type             String    @db.VarChar(100)
  payload          Json
  occurredAt       DateTime  @default(now())
  processedAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime?
  lastError        String?   @db.VarChar(2000)
  deadLetteredAt   DateTime?
  deduplicationKey String?   @unique @db.VarChar(200)
  correlationId    String?   @db.VarChar(64)

  @@index([processedAt, nextAttemptAt, occurredAt])
}

model JobReport {
  id          String          @id @default(uuid())
  jobPostId   String
  reporterId  String
  reason      String          @db.VarChar(200)
  description String?         @db.VarChar(2000)
  status      JobReportStatus @default(Pending)
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  version     Int             @default(0)
  jobPost     JobPost         @relation(fields: [jobPostId], references: [id], onDelete: Restrict)
  reporter    User            @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model NewsletterSubscription {
  id             String    @id @default(uuid())
  userId         String
  email          String    @db.VarChar(320)
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, isActive])
  @@index([isActive, subscribedAt])
}

/// Bảng đăng tin tuyển dụng
model JobPost {
  id                   String        @id @default(uuid())
  title                String        @db.VarChar(200)
  description          String
  skillsRequired       String?       @db.VarChar(500)
  location             String?       @db.VarChar(100)
  salary               Decimal       @db.Decimal(18, 2)
  employerId           String
  employer             User          @relation("EmployerJobs", fields: [employerId], references: [id])
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id])
  logo                 String?       @db.VarChar(300)
  type                 String?       @db.VarChar(50)
  tags                 String?       @db.VarChar(500)
  applicants           Int
  createdAt            DateTime      @default(now())
  deletedAt            DateTime?
  expiresAt            DateTime?
  status               JobPostStatus @default(Active)
  minExperienceYears   Int?
  educationRequirement String?       @db.VarChar(200)
  categoryId           String
  category             Category      @relation(fields: [categoryId], references: [id])
  version              Int           @default(0)
  jobs                 Job[]
  savedJobs            SavedJob[]
  matchResults         MatchResult[]
  reports              JobReport[]

  @@index([deletedAt])
  @@index([status, expiresAt, createdAt])
  @@index([employerId, status, createdAt])
}

/// Kết quả matching được tính theo phiên bản thuật toán và fingerprint đầu vào
model MatchResult {
  id               String   @id @default(uuid())
  candidateId      String
  jobPostId        String
  totalScore       Int
  breakdown        Json
  matchedSkills    Json
  missingSkills    Json
  reasons          Json
  algorithmVersion String   @db.VarChar(20)
  inputFingerprint String   @db.VarChar(64)
  createdAt        DateTime @default(now())
  candidate        User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPost          JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobPostId])
  @@index([jobPostId, totalScore])
  @@index([candidateId, totalScore])
}

model ServicePlan {
  id            String            @id @default(uuid())
  name          String            @db.VarChar(120)
  price         Decimal           @db.Decimal(18, 2)
  currency      String            @default("VND") @db.VarChar(10)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  entitlements  PlanEntitlement[]
  paymentOrders PaymentOrder[]
}

model PlanEntitlement {
  id            String      @id @default(uuid())
  planId        String
  creditType    CreditType
  quantity      Int
  expiresInDays Int?
  plan          ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, creditType])
}

model PaymentOrder {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  vnpTxnRef            String             @unique @db.VarChar(64)
  amount               Decimal            @db.Decimal(18, 2)
  currency             String             @default("VND") @db.VarChar(10)
  status               PaymentOrderStatus @default(Pending)
  providerResponseCode String?            @db.VarChar(10)
  createdAt            DateTime           @default(now())
  expiresAt            DateTime
  paidAt               DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                 ServicePlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  creditLedger         CreditLedger[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model CreditLedger {
  id             String        @id @default(uuid())
  userId         String
  paymentOrderId String?
  creditType     CreditType
  quantity       Int
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@unique([paymentOrderId, creditType])
  @@index([userId, creditType, expiresAt])
}

/// Thông báo
model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  message         String
  read            Boolean
  createdAt       DateTime @default(now())
  type            String?  @db.VarChar(50)
  sourceMessageId String?  @db.VarChar(64)

  @@unique([sourceMessageId, userId])
  @@index([userId, createdAt])
}

/// Đánh giá công ty
model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  rating    Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
}

/// Công việc đã lưu
model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobPostId String
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id])
  savedAt   DateTime @default(now())

  @@unique([userId, jobPostId])
  @@index([jobPostId])
}
